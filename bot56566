import requests
from bs4 import BeautifulSoup
from telegram import Update
from telegram.ext import ApplicationBuilder, MessageHandler, CommandHandler, filters, ContextTypes

TOKEN = "8220980327:AAFQiOztlOZiNtFUQoYWh5TDFdSbIWYSEYk"

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text("👋 أرسل الرقم أو الاسم للبحث")

async def search(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.message.text
    
    try:
        url = f"https://anonimov.net/search?q={query}"
        r = requests.get(url, timeout=10)

        soup = BeautifulSoup(r.text, "html.parser")

        result = soup.get_text()[:1000]

        if result.strip():
            await update.message.reply_text(result)
        else:
            await update.message.reply_text("❌ لم يتم العثور على نتيجة")

    except Exception as e:
        await update.message.reply_text("⚠️ حدث خطأ أثناء البحث")

app = ApplicationBuilder().token(TOKEN).build()

app.add_handler(CommandHandler("start", start))
app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, search))

print("Bot is running...")
app.run_polling()
